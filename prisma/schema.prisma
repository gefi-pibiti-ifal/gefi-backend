// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMINISTRADOR
  FISCAL
}

model User {
  id                String   @id @default(uuid())
  full_name         String
  email             String   @unique
  password_hash     String
  siap_registration String?
  user_type         UserType @default(FISCAL)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  conversations      Conversation[]
  normativeDocuments NormativeDocument[]
  systemAudits       SystemAudit[]

  @@map("users")
}

model Conversation {
  id         String    @id @default(uuid())
  user_id    String
  title      String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  is_pinned  Boolean   @default(false)
  deleted_at DateTime?

  user               User                  @relation(fields: [user_id], references: [id])
  interactionHistory InteractionHistory[]
  feedback           ConversationFeedback?

  @@map("conversations")
}

model InteractionHistory {
  id              String   @id @default(uuid())
  conversation_id String
  user_query      String
  ai_response     String
  created_at      DateTime @default(now())

  conversation    Conversation     @relation(fields: [conversation_id], references: [id])
  responseSources ResponseSource[]

  @@map("interaction_history")
}

model ResponseSource {
  id             String @id @default(uuid())
  interaction_id String
  normative_id   String

  interaction InteractionHistory      @relation(fields: [interaction_id], references: [id])
  normative   NormativeDocument       @relation(fields: [normative_id], references: [id])
  excerpts    ResponseSourceExcerpt[]

  @@map("response_sources")
}

// Rastreabilidade fina da fonte: um registro por TRECHO que efetivamente
// entrou no prompt. ResponseSource continua sendo um registro por DOCUMENTO
// (contrato preservado); os trechos penduram nele a localizacao dentro do
// documento, permitindo que o historico reabra a resposta na mesma regiao.
//
// char_start/char_end sao offsets em NormativeDocument.indexed_content (ver
// document-location.ts). Todos os campos de localizacao sao opcionais: um
// documento indexado antes desta funcionalidade produz trechos sem
// localizacao, e a fonte segue valida como referencia ao documento.
model ResponseSourceExcerpt {
  id                 String   @id @default(uuid())
  response_source_id String
  parent_chunk_id    String?
  section_header     String?
  n1_header          String?
  n2_header          String?
  citation           String?
  excerpt            String
  role               String?
  rank               Int      @default(0)
  page_start         Int?
  page_end           Int?
  char_start         Int?
  char_end           Int?
  location_precision String?
  created_at         DateTime @default(now())

  responseSource ResponseSource @relation(fields: [response_source_id], references: [id], onDelete: Cascade)
  parentChunk    ParentChunk?   @relation(fields: [parent_chunk_id], references: [id], onDelete: SetNull)

  @@index([response_source_id])
  @@index([parent_chunk_id])
  @@map("response_source_excerpts")
}

model ConversationFeedback {
  id              String  @id @default(uuid())
  conversation_id String  @unique
  rating          Int
  accuracy_check  Boolean
  comment         String?

  conversation Conversation @relation(fields: [conversation_id], references: [id])

  @@map("conversation_feedbacks")
}

model NormativeDocument {
  id               String    @id @default(uuid())
  title            String
  document_type    String
  original_content String
  admin_id         String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  // Arquivo original preservado para visualizacao e download. Antes desta
  // funcionalidade so o TEXTO extraido era guardado e o PDF era descartado
  // apos a extracao — documentos enviados antes disso continuam validos, mas
  // com file_name nulo (sem arquivo para baixar).
  file_name      String?
  file_mime_type String?
  file_size      Int?
  file_hash      String? // sha256 do arquivo original (integridade/auditoria)
  file_data      Bytes? // NUNCA selecionar em listagens: e o PDF inteiro

  // Texto limpo usado na indexacao. E o sistema de coordenadas de
  // char_start/char_end (ParentChunk.metadata e ResponseSourceExcerpt) e o
  // conteudo servido ao visualizador quando o arquivo original nao existe.
  indexed_content String?
  // Mapa de paginas: [{ page_start, page_end, start, end }] em coordenadas de
  // indexed_content. Vazio/nulo quando a extracao nao preservou paginas.
  page_map        Json?
  total_pages     Int?

  admin           User             @relation(fields: [admin_id], references: [id])
  responseSources ResponseSource[]
  parentChunks    ParentChunk[]

  @@map("normative_documents")
}

model ParentChunk {
  id             String   @id @default(uuid())
  document_id    String
  section_header String
  content        String
  // Alem de documentId/title/n1_header/n2_header, guarda a localizacao do
  // dispositivo no documento: char_start, char_end (offsets em
  // indexed_content) e page_start, page_end quando as paginas sao conhecidas.
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())

  document NormativeDocument       @relation(fields: [document_id], references: [id], onDelete: Cascade)
  excerpts ResponseSourceExcerpt[]

  @@map("parent_chunks")
}

model SystemAudit {
  id          String   @id @default(uuid())
  user_id     String
  action      String
  entity_name String
  entity_id   String?
  details     Json?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("system_audits")
}
