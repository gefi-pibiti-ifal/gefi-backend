# Copie para .env e preencha. O .env nunca vai para o git (ver .gitignore) nem
# para dentro da imagem (ver .dockerignore) -- o compose o injeta em tempo de
# execucao via env_file.

# ---- Aplicacao ----
PORT=3000
NODE_ENV=production

# ---- Banco de dados ----
# Usados pelo compose para subir o Postgres e montar o DATABASE_URL da API.
# Gere a senha, nao reaproveite a do exemplo:
#   openssl rand -base64 32
POSTGRES_USER=gefi
POSTGRES_PASSWORD=
POSTGRES_DB=gefi_db

# Usado quando a aplicacao roda FORA do container (pnpm start:dev). Dentro do
# compose esta variavel e sobreposta para apontar ao servico `postgres`.
DATABASE_URL="postgresql://gefi:SENHA_AQUI@localhost:5432/gefi_db?schema=public"

# ---- Autenticacao ----
# Segredo de assinatura dos JWT. Gere um valor aleatorio por ambiente:
#   openssl rand -hex 64
JWT_SECRET=

# ---- Provedores de IA ----
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# ---- Deploy (opcional) ----
# Interface em que o servico api-deploy publica a porta 2999.
# Use 127.0.0.1 quando houver um reverse proxy com TLS na frente (recomendado).
API_BIND=0.0.0.0
# false quando houver mais de uma replica da API rodando ao mesmo tempo.
RUN_MIGRATIONS=true
