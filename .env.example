# Copie para .env e preencha. O .env nunca vai para o git (ver .gitignore) nem
# para dentro da imagem (ver .dockerignore) -- o compose o injeta em tempo de
# execucao via env_file.

# ---- Aplicacao ----
PORT=3000
NODE_ENV=production

# ---- Banco de dados ----
# Usados pelo compose para subir o Postgres e montar o DATABASE_URL da API.
# Gere a senha, nao reaproveite a do exemplo:
#   openssl rand -base64 32
POSTGRES_USER=gefi
POSTGRES_PASSWORD=
POSTGRES_DB=gefi_db

# Usado quando a aplicacao roda FORA do container (pnpm start:dev). Dentro do
# compose esta variavel e sobreposta para apontar ao servico `postgres`.
DATABASE_URL="postgresql://gefi:SENHA_AQUI@localhost:5432/gefi_db?schema=public"

# ---- Autenticacao ----
# OBRIGATORIA. A aplicacao NAO SOBE sem ela -- nao ha mais valor padrao no
# codigo. Minimo de 32 caracteres. Gere um valor diferente por ambiente:
#   openssl rand -hex 64
JWT_SECRET=

# Validade da sessao (formato: 30m, 8h, 7d). Define tambem o Max-Age do cookie.
JWT_EXPIRES_IN=8h

# Envia o cookie de sessao apenas sob HTTPS. Deixe true em qualquer ambiente
# publicado; so use false para desenvolvimento local em http://localhost.
COOKIE_SECURE=true

# ---- Login com Google ----
# OBRIGATORIA. Client ID do tipo "Web application", criado em
# console.cloud.google.com > APIs & Services > Credentials.
# Termina em .apps.googleusercontent.com. O Client Secret NAO e usado neste
# fluxo (o navegador entrega um ID token, que o backend apenas verifica).
GOOGLE_CLIENT_ID=

# Dominio do Google Workspace exigido no login, comparado com a claim `hd` do
# ID token. Vazio => qualquer conta Google pode entrar DESDE QUE o e-mail ja
# esteja pre-cadastrado na tabela de usuarios (util para liberar um avaliador
# externo sem alterar codigo).
GOOGLE_ALLOWED_HD=ifal.edu.br

# Administradores semeados no boot, separados por virgula.
#
# LEIA ANTES DE DEIXAR VAZIO: nao existe login por senha e so um ADMINISTRADOR
# pode cadastrar outras pessoas. Num banco novo, sem esta variavel ninguem
# consegue entrar -- nem para criar o primeiro administrador. Tambem e a forma
# de recuperar o acesso se a ultima conta de administrador for perdida.
BOOTSTRAP_ADMIN_EMAILS=

# Origens permitidas no CORS, separadas por virgula. Deixe VAZIO quando o
# frontend acessa pelo proxy same-origin do Next (o caso normal em producao).
# Preencha so se o front rodar noutra origem, ex.: http://localhost:3001
CORS_ORIGIN=

# ---- Provedores de IA ----
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# ---- Deploy (opcional) ----
# Interface em que o servico api-deploy publica a porta 2999.
# Use 127.0.0.1 quando houver um reverse proxy com TLS na frente (recomendado).
API_BIND=0.0.0.0
# false quando houver mais de uma replica da API rodando ao mesmo tempo.
RUN_MIGRATIONS=true
